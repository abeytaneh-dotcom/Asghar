#include <Arduino.h>
#include <NimBLEDevice.h>
#include <Preferences.h>
#include "driver/twai.h"

/*
 * KHANEH REMAP - Smart OBD Diagnostic Pro
 * ESP32-C3 VCI firmware
 *
 * Hardware expected by this build:
 *   CAN transceiver (SN65HVD230 / TJA1051 class): TX=GPIO4, RX=GPIO5
 *   K-Line transceiver (L9637D / MC33290): RX=GPIO6, TX=GPIO7
 *   Coolant level input: GPIO3, active LOW when water is present
 *
 * The ESP32-C3 is the VCI. It never drives an automotive bus directly.
 */

static constexpr const char* FW_VERSION = "4.0.0-diagnostic-pro";
static constexpr const char* DEVICE_PREFIX = "KR_OBD_";

static constexpr gpio_num_t PIN_CAN_TX = GPIO_NUM_4;
static constexpr gpio_num_t PIN_CAN_RX = GPIO_NUM_5;
static constexpr int PIN_KLINE_RX = 6;
static constexpr int PIN_KLINE_TX = 7;
static constexpr int PIN_COOLANT = 3;
static constexpr bool COOLANT_WET_ACTIVE_LOW = true;

static constexpr const char* UUID_SERVICE = "7f640201-7c7d-4f0a-8b6f-4f484f4d4501";
static constexpr const char* UUID_CMD     = "7f640202-7c7d-4f0a-8b6f-4f484f4d4501";
static constexpr const char* UUID_DATA    = "7f640203-7c7d-4f0a-8b6f-4f484f4d4501";

struct ByteBuf {
  uint8_t data[300];
  size_t len = 0;
  void clear(){ len = 0; }
  bool push(uint8_t b){ if(len >= sizeof(data)) return false; data[len++] = b; return true; }
};

struct LiveData {
  float rpm=NAN, speed=NAN, ect=NAN, fuel=NAN, volts=NAN, load=NAN, map=NAN, iat=NAN,
        maf=NAN, throttle=NAN, advance=NAN, stft=NAN, ltft=NAN, runtime=NAN;
};

Preferences prefs;
HardwareSerial KLine(1);
NimBLECharacteristic* chData=nullptr;
QueueHandle_t commandQueue=nullptr;

volatile bool bleConnected=false;
bool liveStreaming=false;
bool canStarted=false;
bool klineStarted=false;
int canRate=0;
uint32_t canRequestId=0x7E0;
uint32_t canResponseId=0x7E8;
String protocolName="NONE";
String deviceSerial="";
String selectedBrand="";
String selectedModel="";
String selectedEcu="";
LiveData live;
bool pidSupported[0x61] = {false};
uint32_t lastLivePoll=0;
uint32_t lastCoolantSample=0;
uint32_t lastCoolantAlarm=0;
uint8_t coolantDryCount=0;
uint8_t coolantWetCount=0;
bool lowCoolant=false;

struct CommandPacket { char text[220]; };

static String chipSuffix(){
  uint64_t mac=ESP.getEfuseMac();
  char out[13];
  snprintf(out,sizeof(out),"%012llX",(unsigned long long)mac);
  return String(out);
}

static String deviceName(){ return String(DEVICE_PREFIX)+chipSuffix().substring(6); }

static bool validSerial(String s){
  s.trim(); s.toUpperCase();
  int p1=s.indexOf('-'), p2=s.indexOf('-',p1+1);
  if(p1<2 || p1>8 || p2!=p1+3 || s.length()!=p2+7) return false;
  for(int i=0;i<p1;i++) if(!isalnum((unsigned char)s[i])) return false;
  for(int i=p1+1;i<p2;i++) if(!isDigit(s[i])) return false;
  for(int i=p2+1;i<(int)s.length();i++) if(!isDigit(s[i])) return false;
  return true;
}

static uint8_t txId=0;
static void bleNotifyRaw(const String& s){
  if(!chData || !bleConnected) return;
  std::string v(s.c_str(),s.length());
  chData->setValue(v); chData->notify();
}

static void bleOut(const String& text){
  Serial.println(text);
  if(!bleConnected || !chData) return;
  // Messages <= 20 bytes work before/without MTU negotiation.
  if(text.length()<=20){ bleNotifyRaw(text); return; }
  // Conservative fragments stay <= 20 bytes: X|ID|SEQ|TOT| + 9 bytes.
  const int chunk=9;
  int total=(text.length()+chunk-1)/chunk;
  if(total>255){ bleNotifyRaw("ERR|TX_TOO_LONG"); return; }
  uint8_t id=++txId;
  char head[16];
  for(int seq=0;seq<total;seq++){
    snprintf(head,sizeof(head),"X|%02X|%02X|%02X|",id,seq,total);
    int from=seq*chunk;
    bleNotifyRaw(String(head)+text.substring(from,min(from+chunk,(int)text.length())));
    delay(2);
  }
}

static String part(const String& s,int index){
  int start=0;
  for(int i=0;i<index;i++){
    int p=s.indexOf('|',start); if(p<0) return ""; start=p+1;
  }
  int e=s.indexOf('|',start); if(e<0) e=s.length();
  return s.substring(start,e);
}

static void stopCAN(){
  if(canStarted){ twai_stop(); twai_driver_uninstall(); }
  canStarted=false; canRate=0;
}

static bool startCAN(int kbps){
  stopCAN();
  twai_general_config_t g=TWAI_GENERAL_CONFIG_DEFAULT(PIN_CAN_TX,PIN_CAN_RX,TWAI_MODE_NORMAL);
  g.tx_queue_len=12; g.rx_queue_len=36; g.alerts_enabled=TWAI_ALERT_BUS_OFF|TWAI_ALERT_ERR_PASS;
  twai_timing_config_t t = (kbps==250) ? TWAI_TIMING_CONFIG_250KBITS() : TWAI_TIMING_CONFIG_500KBITS();
  twai_filter_config_t f=TWAI_FILTER_CONFIG_ACCEPT_ALL();
  if(twai_driver_install(&g,&t,&f)!=ESP_OK) return false;
  if(twai_start()!=ESP_OK){ twai_driver_uninstall(); return false; }
  canStarted=true; canRate=kbps; return true;
}

static void canFlush(){ twai_message_t m; while(twai_receive(&m,0)==ESP_OK){} }

static bool canTx(uint32_t id,const uint8_t* d,uint8_t n){
  twai_message_t m={}; m.identifier=id; m.data_length_code=n; m.extd=0; m.rtr=0;
  memcpy(m.data,d,n); return twai_transmit(&m,pdMS_TO_TICKS(60))==ESP_OK;
}

// Send an ISO-TP single-frame request and receive a single or multi-frame response.
static bool canIsoTpRequest(const uint8_t* req,size_t reqLen,ByteBuf& out,uint32_t timeoutMs=650,bool functional=false){
  if(!canStarted || reqLen>7) return false;
  canFlush(); out.clear();
  uint8_t frame[8]; memset(frame,0x55,sizeof(frame));
  frame[0]=(uint8_t)reqLen; memcpy(frame+1,req,reqLen);
  uint32_t txId=functional?0x7DF:canRequestId;
  if(!canTx(txId,frame,8)) return false;

  uint32_t start=millis(); bool began=false; size_t expected=0; uint8_t nextSeq=1; uint32_t responder=0;
  while(millis()-start<timeoutMs){
    twai_message_t r;
    if(twai_receive(&r,pdMS_TO_TICKS(25))!=ESP_OK) continue;
    if(r.extd || r.data_length_code<2) continue;
    if(functional){ if(r.identifier<0x7E8 || r.identifier>0x7EF) continue; }
    else if(r.identifier!=canResponseId) continue;

    uint8_t type=r.data[0]>>4;
    if(type==0){
      size_t n=r.data[0]&0x0F; if(n>7) n=7;
      for(size_t i=0;i<n;i++) out.push(r.data[1+i]);
      if(functional){ canResponse