Options -Indexes
DirectoryIndex index.php
<FilesMatch "^(config\.php|install\.lock\.php|admin_auth\.php|backup_cli\.php|backup_lib\.php|README\.txt)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set X-Frame-Options "SAMEORIGIN"
 Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
 Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
 <FilesMatch "\.(js|css)$">
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
 </FilesMatch>
 <Files "admin.php">
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Clear-Site-Data "\"cache\""
 </Files>
</IfModule>
