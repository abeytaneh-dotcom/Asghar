# safe-errors-v16-production
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
 RewriteEngine On
 # Preserve Bearer authentication for PHP-FPM/CGI so Websaz Store desktop sync can authenticate.
 RewriteCond %{HTTP:Authorization} ^(.+)$
 RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
 # Legacy hero endpoint remains available for compatibility, but the storefront now uses the vector hero directly.
 RewriteCond %{QUERY_STRING} (^|&)tm_asset=hero_v22(&|$)
 RewriteRule ^shop\.php$ hero_v22.php [END]
 RewriteRule ^install\.php$ error.php?s=403 [END,QSA]
</IfModule>
ErrorDocument 403 /tehran/error.php?s=403
ErrorDocument 404 /tehran/error.php?s=404
ErrorDocument 413 /tehran/error.php?s=413
ErrorDocument 429 /tehran/error.php?s=429
ErrorDocument 500 /tehran/error.php?s=500
<FilesMatch "^(config\.php|install\.lock\.php|admin_auth\.php|backup_cli\.php|backup_lib\.php|store_lib\.php|sms_lib\.php|coupon_lib\.php|error_bootstrap\.php|location_resolve\.php|README\.txt)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set X-Frame-Options "SAMEORIGIN"
 Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
 Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; connect-src 'self' https:; font-src 'self' https: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
 <FilesMatch "\.(js|css)$">
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
 </FilesMatch>
 <FilesMatch "^(index|shop|admin|admin_orders|admin_store|admin_discounts|admin_users|admin_products|admin_couriers|admin_order_edit|admin_integrations|admin_coupons|pyramid|track|courier|account|error)\.php$">
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
 </FilesMatch>
 <Files "admin.php">
  Header always set Clear-Site-Data "\"cache\""
 </Files>
</IfModule>

# Force the approved storefront assets while keeping the server-side visual overlay disabled.
<IfModule mod_filter.c>
  AddOutputFilterByType SUBSTITUTE text/html
</IfModule>
<IfModule mod_substitute.c>
  Substitute "s|assets/ai_entry_flow.js?v=20261026-1|assets/ai_entry_flow.js?v=20261027-102|ni"
  Substitute "s|assets/style.css?v=20261024-shop3|assets/style.css?v=20261027-critical7|ni"
  # Cache-bust the desktop hero and replace the low-resolution mobile JPEG with the same true-vector hero.
  Substitute "s|assets/tehran-storefront-v3.svg?v=20261027-ref18|assets/tehran-storefront-v3.svg?v=20261027-hq1|ni"
  Substitute "s|shop.php?tm_asset=hero_v22&v=20261027-27|assets/tehran-storefront-v3.svg?v=20261027-hq1|ni"
</IfModule>
