Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Canonical WebSaza host.
RewriteCond %{HTTP_HOST} ^(?:www\.)?websaza\.ir$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.websaza\.ir$ [NC]
RewriteRule ^ https://websaza.ir%{REQUEST_URI} [R=301,L,NE]

# Canonical Niazestan host once the registered domain is delegated here.
RewriteCond %{HTTP_HOST} ^(?:www\.)?niazestan\.ir$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.niazestan\.ir$ [NC]
RewriteRule ^ https://niazestan.ir%{REQUEST_URI} [R=301,L,NE]

# Unknown hosts still canonicalize to WebSaza.
RewriteCond %{HTTP_HOST} !^websaza\.ir$ [NC]
RewriteCond %{HTTP_HOST} !^niazestan\.ir$ [NC]
RewriteRule ^ https://websaza.ir%{REQUEST_URI} [R=301,L,NE]

# On the standalone Niazestan domain, the root opens the marketplace directly.
RewriteCond %{HTTP_HOST} ^niazestan\.ir$ [NC]
RewriteRule ^$ nz-entry.php [L,QSA]

# Never expose internal data, backups or database files.
RewriteRule ^\.marketplace-data(?:/|$) - [R=404,L]
RewriteRule (^|/)(?:niazestan\.sqlite3|data\.json|rate-limit\.json|audit\.log)$ - [R=404,L,NC]
RewriteRule \.(?:sqlite3?|db|log|bak|lock)$ - [R=404,L,NC]

# Hide temporary diagnostics even if an old copy still exists on hosting.
RewriteRule ^nz-capability\.php$ - [R=404,L]

# Serve Niyazestan service worker through a stable dynamic endpoint.
RewriteRule ^niazestan-sw\.js$ nz-sw.php [L]

# Niyazestan sitemap.
RewriteRule ^nz-sitemap\.xml$ nz-sitemap.php [L,QSA]

# Niyazestan canonical public URL.
RewriteCond %{THE_REQUEST} \s/+marketplace\.php(?:[?\s]) [NC]
RewriteRule ^marketplace\.php$ /nz [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+niyazestan\.php(?:[?\s]) [NC]
RewriteRule ^niyazestan\.php$ /nz [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+nz-app\.php(?:[?\s]) [NC]
RewriteRule ^nz-app\.php$ /nz [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+nz-v2\.php(?:[?\s]) [NC]
RewriteRule ^nz-v2\.php$ /nz [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+nz-entry\.php(?:[?\s]) [NC]
RewriteRule ^nz-entry\.php$ /nz [R=301,L,NE]

# Serve the short app URL through a root-level entrypoint that is always deployed.
RewriteRule ^nz/?$ nz-entry.php [L,QSA]

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(html?|php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
